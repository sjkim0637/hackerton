<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <ImageView
        android:id="@+id/backgroundOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.5"
        android:visibility="gone"
        android:contentDescription="배경 오버레이"
        android:clickable="false"
        android:focusable="false" />
    <ImageView
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="삭제 결과"
        android:clickable="false"
        android:focusable="false" />
    <com.hackathon.interior.remove.BboxSelectionView
        android:id="@+id/bboxSelectionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/arTopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_workspace_panel"
        android:padding="12dp"
        android:clickable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnWorkspaceHome"
                style="@style/WorkspaceButton"
                android:text="‹  화보"
                android:contentDescription="화보로 돌아가기" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="내 공간에 배치"
                android:gravity="center"
                android:textColor="#F8F5F0"
                android:textStyle="bold"
                android:textSize="16sp" />
            <ImageButton
                android:id="@+id/btnWorkspaceSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_workspace_panel"
                android:contentDescription="설정"
                android:padding="12dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/instruction_scan"
            android:textColor="#F8F5F0"
            android:textSize="15sp"
            android:paddingVertical="6dp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <com.hackathon.interior.ui.WorkspaceScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_workspace_panel"
        android:scrollbars="vertical"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:clickable="true">
            <LinearLayout
                android:id="@+id/selectionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingBottom="8dp">
                <TextView
                    android:id="@+id/selectedNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="선택한 가구"
                    android:textColor="#F8F5F0"
                    android:textSize="15sp"
                    android:paddingVertical="6dp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnShrink"
                        style="@style/WorkspaceButton"
                        android:text="−"
                        android:contentDescription="가구 크기 줄이기" />
                    <Button
                        android:id="@+id/btnGrow"
                        style="@style/WorkspaceButton"
                        android:text="＋"
                        android:contentDescription="가구 크기 키우기" />
                    <Button
                        android:id="@+id/btnRotateLeft"
                        style="@style/WorkspaceButton"
                        android:text="↶ 15°"
                        android:contentDescription="왼쪽으로 15도 회전" />
                    <Button
                        android:id="@+id/btnRotateRight"
                        style="@style/WorkspaceButton"
                        android:text="15° ↷"
                        android:contentDescription="오른쪽으로 15도 회전" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnDelete"
                        style="@style/WorkspaceButton"
                        android:text="가구 삭제"
                        android:textColor="#FFB4AB" />
                    <Button
                        android:id="@+id/btnDeselect"
                        style="@style/WorkspaceButton"
                        android:text="편집 완료" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/movedObjectPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="지운 사물 편집"
                    android:textColor="#F8F5F0"
                    android:textSize="15sp"
                    android:paddingVertical="6dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnMovedHome"
                        style="@style/WorkspaceButton"
                        android:text="원위치" />
                    <Button
                        android:id="@+id/btnMovedClear"
                        style="@style/WorkspaceButton"
                        android:text="치우기" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnMovedShrink"
                        style="@style/WorkspaceButton"
                        android:text="−"
                        android:contentDescription="사물 크기 줄이기" />
                    <Button
                        android:id="@+id/btnMovedGrow"
                        style="@style/WorkspaceButton"
                        android:text="＋"
                        android:contentDescription="사물 크기 키우기" />
                    <Button
                        android:id="@+id/btnMovedRotate"
                        style="@style/WorkspaceButton"
                        android:text="회전 ↷" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnMovedRestore"
                        style="@style/WorkspaceButton"
                        android:text="배치 복원"
                        android:enabled="false" />
                    <Button
                        android:id="@+id/btnMovedUndo"
                        style="@style/WorkspaceButton"
                        android:text="실행 취소"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Button
                    android:id="@+id/btnAddFurniture"
                    style="@style/WorkspaceButton"
                    android:text="다른 가구" />
                <Button
                    android:id="@+id/btnRemovalTools"
                    style="@style/WorkspaceButton"
                    android:text="사물 지우기 ▾"
                    android:contentDescription="사물 지우기 도구 펼치기" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/removalTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1  지울 사물을 고르세요"
                    android:textColor="#F8F5F0"
                    android:textSize="15sp"
                    android:paddingVertical="6dp" />
                <LinearLayout
                    android:id="@+id/removalTypeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="사물 종류"
                        android:textColor="#F8F5F0"
                        android:textSize="14sp"
                        android:layout_marginEnd="12dp" />
                    <Spinner
                        android:id="@+id/objectTypeSpinner"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:background="#403A34"
                        android:popupBackground="#FFFFFF" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/removalSelectionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnTvSelectMode"
                        style="@style/WorkspaceButton"
                        android:text="2  영역 선택" />
                    <Button
                        android:id="@+id/btnClearSelection"
                        style="@style/WorkspaceButton"
                        android:text="선택 취소"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/removalRequestRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnRequestRemove"
                        style="@style/WorkspaceButton"
                        android:text="3  사물 지우기"
                        android:enabled="false"
                        app:backgroundTint="@color/workspace_primary_tint"
                        android:textColor="@color/workspace_primary_text" />
                    <Button
                        android:id="@+id/btnToggleRemoval"
                        style="@style/WorkspaceButton"
                        android:text="삭제 전 / 후"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView
                    android:id="@+id/removalStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#F8F5F0"
                    android:textSize="15sp"
                    android:paddingVertical="6dp"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/arPrimaryActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Button
                    android:id="@+id/btnCaptureBg"
                    style="@style/WorkspaceButton"
                    android:text="배경 촬영" />
                <Button
                    android:id="@+id/btnToggleBg"
                    style="@style/WorkspaceButton"
                    android:text="배경 표시"
                    android:enabled="false" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/opacitySeekBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="100"
                android:progress="50"
                android:visibility="gone"
                android:contentDescription="배경 투명도" />
        </LinearLayout>
    </com.hackathon.interior.ui.WorkspaceScrollView>
    <!-- 첫 화면 가구 브로셔. 항목을 선택하고 "우리 집에 적용"을 누른 뒤
         해당 종류에 맞는 평면(벽/바닥)을 탭하면 저폴리 3D 가구가 배치된다. -->
    <LinearLayout
        android:id="@+id/catalogPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E6000000"
        android:padding="12dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="우리 집을 위한 가구 브로셔"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="샘플 가구를 선택해 실제 크기의 3D 모델로 배치해 보세요"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnCatalogClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="닫기" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/catalogList"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView
            android:id="@+id/catalogSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="가구를 선택해 크기와 배치 위치를 확인하세요"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btnCatalogApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:enabled="false"
            android:text="우리 집에 적용" />
    </LinearLayout>
    <!-- 제공 Asset 디자인을 적용한 제품 진입 화면. AR 기능은 선택 후에만 노출한다. -->
    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3EEE7"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="720dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="42dp"
            android:paddingBottom="26dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.22"
                        android:text="MY HOME"
                        android:textColor="#211E1B"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:letterSpacing="0.32"
                        android:text="INTERIOR"
                        android:textColor="#8B7256"
                        android:textSize="10sp" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/btnHomeSettings"
                    android:layout_width="54dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#211E1B"
                    android:contentDescription="설정"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginTop="22dp">
                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="따뜻한 거실 인테리어" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="CREATE YOUR SPACE"
                        android:textColor="#E5BD7D"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="새로운 공간,\n새로운 일상"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="카메라로 공간을 읽고 가구를 직접 배치해 보세요."
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="어떤 작업을 시작할까요?"
                android:textColor="#211E1B"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="기능별 화면은 필요할 때만 열립니다."
                android:textColor="#7C746C"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnHomeArPlacement"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#211E1B"
                android:text="▣   내 집에 AR로 배치하기   ›"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHomeSpaceEdit"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#DAB476"
                android:text="✦   사진에서 사물 지우기   ›"
                android:textAllCaps="false"
                android:textColor="#211E1B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHomeCatalog"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="▤   가구 카탈로그 둘러보기   ›"
                android:textAllCaps="false"
                android:textColor="#211E1B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.1"
                android:text="CURATED FOR YOU"
                android:textColor="#8B7256"
                android:textSize="11sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeCategoryLiving"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:contentDescription="거실 가구" />
                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeCategoryDining"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:contentDescription="주방 식탁" />
                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeCategoryDecor"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:contentDescription="데코 소품" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!-- 서버 주소 등 기술 설정은 작업 화면에서 분리한다. -->
    <FrameLayout
        android:id="@+id/settingsScreen"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3EEE7"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFFFF"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SETTINGS"
                android:textColor="#A17B45"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="앱 설정"
                android:textColor="#211E1B"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Interior API 서버 주소"
                android:textColor="#403A34"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#A17B45"
                android:hint="http://192.168.0.10:8000"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#211E1B"
                android:textColorHint="#887E75" />
            <TextView
                android:id="@+id/settingsServerHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="휴대폰과 서버 PC가 같은 Wi-Fi에 있어야 합니다."
                android:textColor="#7C746C"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnSettingsSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#DAB476"
                android:text="저장"
                android:textColor="#211E1B"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnSettingsCancel"
