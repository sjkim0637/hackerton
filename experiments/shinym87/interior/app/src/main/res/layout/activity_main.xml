<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 서버가 돌려준 "삭제 후" 결과 이미지 (벽 평면 앵커를 못 잡았을 때의 전체화면 대체 표시).
         평소에는 3D quad 로 벽에 붙이고, 이 뷰는 fallback 이다. -->
    <ImageView
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="삭제 결과"
        android:clickable="false"
        android:focusable="false" />

    <!-- D8: 탭 직후 MobileSAM 마스크 미리보기(인페인팅 전). sceneView 와 같은 픽셀 크기의
         키프레임 위에 계산된 마스크라 FIT_XY 로 그대로 겹치면 위치가 맞는다. -->
    <ImageView
        android:id="@+id/maskPreviewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="선택된 영역 미리보기"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/instruction_scan"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="6" />

        <!-- D5/D7: 화면을 탭하면 그 자리의 사물을 마스킹→확인 후 지운다(MobileSAM + LaMa).
             예전엔 "영역 선택 모드"로 사각형을 그리고 사물 종류를 고른 뒤 "삭제 요청"을
             눌러야 했지만(D3), 이제 그 단계들이 필요 없어져 버튼도 없앴다. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleRemoval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="삭제 전/후" />
        </LinearLayout>

        <!-- 서버 주소. 실기기에서는 localhost 가 아니라 서버 PC 의 LAN IP 를 넣어야 한다.
             입력값은 저장되어 다음 실행에도 유지된다. -->
        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#33FFFFFF"
            android:textColor="@android:color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="13sp"
            android:padding="8dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:hint="서버 주소 (예: http://192.168.0.10:8000)"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/removalStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="6"
            android:text="" />
    </LinearLayout>

    <!-- PHASE 5: 서버 카탈로그에서 새 가구를 골라 배치 (삭제-후-재배치와 별개). 다른 조작
         패널(이동/선택/카탈로그)과 안 겹치게 화면 우하단에 고정. -->
    <Button
        android:id="@+id/btnAddFurniture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:text="가구 추가" />

    <!-- D8: 탭 → 마스킹 미리보기 → 이 패널로 삭제 확정/취소. "삭제"를 눌러야 그때
         인페인팅(LaMa)이 실행된다 — 탭만으로 바로 지워지지 않는다. -->
    <LinearLayout
        android:id="@+id/maskConfirmPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="10dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMaskDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제" />

        <Button
            android:id="@+id/btnMaskCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="취소" />
    </LinearLayout>

    <!-- PHASE 4/5: 삭제한 사물을 이동하는 패널. 삭제 완료 시 나타나고, 마커가 바로 떠서
         손가락으로 끌어 옮긴다("여기로 옮기기" 버튼 없음). -->
    <LinearLayout
        android:id="@+id/movedObjectPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원위치" />

            <Button
                android:id="@+id/btnMovedClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="치우기" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedShrink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="－" />

            <Button
                android:id="@+id/btnMovedGrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="＋" />

            <Button
                android:id="@+id/btnMovedRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="회전 ⟳" />
        </LinearLayout>
    </LinearLayout>

    <!-- 가구를 선택하면 나타나는 조작 패널 (핀치로도 크기 조절 가능) -->
    <LinearLayout
        android:id="@+id/selectionPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectedNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="선택됨" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShrink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="－" />

            <Button
                android:id="@+id/btnGrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="＋" />

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="회전 ⟳" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삭제" />

            <Button
                android:id="@+id/btnDeselect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="선택 해제" />
        </LinearLayout>
    </LinearLayout>

    <!-- PHASE 5: "가구 추가" 를 누르면 뜨는 서버 카탈로그 목록. 한 항목을 고르면
         해당 종류에 맞는 평면(벽/바닥)을 탭해 배치한다. -->
    <LinearLayout
        android:id="@+id/catalogPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E6000000"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="가구 카탈로그 (서버)"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnCatalogClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="닫기" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/catalogList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
