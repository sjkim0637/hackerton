<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 저장해 둔 "빈 배경" 대표 이미지를 카메라 위에 반투명으로 겹친다.
         clickable=false 라 터치는 아래 sceneView 로 그대로 전달된다. -->
    <ImageView
        android:id="@+id/backgroundOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.5"
        android:visibility="gone"
        android:contentDescription="배경 오버레이"
        android:clickable="false"
        android:focusable="false" />

    <!-- 서버가 돌려준 "삭제 후" 결과 이미지 (벽 평면 앵커를 못 잡았을 때의 전체화면 대체 표시).
         평소에는 3D quad 로 벽에 붙이고, 이 뷰는 fallback 이다. -->
    <ImageView
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="삭제 결과"
        android:clickable="false"
        android:focusable="false" />

    <!-- "TV 선택 모드"에서 화면을 드래그해 제거할 사물의 사각형(bounding box)을 그린다.
         visibility=gone 이면 터치를 먹지 않아 평소 탭/드래그에 영향이 없다. -->
    <com.hackathon.interior.remove.BboxSelectionView
        android:id="@+id/bboxSelectionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/instruction_scan"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="6" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCaptureBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="배경 촬영" />

            <Button
                android:id="@+id/btnToggleBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="배경 표시" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/opacitySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="50"
            android:visibility="gone" />

        <!-- 사물 제거 흐름 (P1-2/P1-3/P1-8/P1-9) -->

        <!-- 서버 주소. 실기기에서는 localhost 가 아니라 서버 PC 의 LAN IP 를 넣어야 한다.
             입력값은 저장되어 다음 실행에도 유지된다. -->
        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#33FFFFFF"
            android:textColor="@android:color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="13sp"
            android:padding="8dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:hint="서버 주소 (예: http://192.168.0.10:8000)"
            android:importantForAutofill="no" />

        <!-- 지울 사물 종류. 서버 요청의 objectType 이 이 선택값을 따라간다. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지울 사물"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:shadowColor="@android:color/black"
                android:shadowRadius="6" />

            <Spinner
                android:id="@+id/objectTypeSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="96dp"
                android:background="#33FFFFFF"
                android:popupBackground="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTvSelectMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영역 선택 모드" />

            <Button
                android:id="@+id/btnClearSelection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:text="선택 취소" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRequestRemove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="삭제 요청" />

            <Button
                android:id="@+id/btnToggleRemoval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:text="삭제 전/후" />
        </LinearLayout>

        <TextView
            android:id="@+id/removalStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="6"
            android:text="" />
    </LinearLayout>

    <!-- PHASE 4: 삭제한 사물을 다른 위치로 "이동" 하는 패널. 삭제 완료 시 나타난다.
         "여기로 옮기기" → 새 지점 탭 → 원래 사물 이미지가 그 자리에 나타남. -->
    <LinearLayout
        android:id="@+id/movedObjectPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedPlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여기로 옮기기" />

            <Button
                android:id="@+id/btnMovedHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="원위치" />

            <Button
                android:id="@+id/btnMovedClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="치우기" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedShrink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="－" />

            <Button
                android:id="@+id/btnMovedGrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="＋" />

            <Button
                android:id="@+id/btnMovedRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="회전 ⟳" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedRestore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="서버 배치 복원" />

            <Button
                android:id="@+id/btnMovedUndo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="실행 취소" />
        </LinearLayout>
    </LinearLayout>

    <!-- 가구를 선택하면 나타나는 조작 패널 (핀치로도 크기 조절 가능) -->
    <LinearLayout
        android:id="@+id/selectionPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectedNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="선택됨" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShrink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="－" />

            <Button
                android:id="@+id/btnGrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="＋" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="삭제" />

            <Button
                android:id="@+id/btnDeselect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="선택 해제" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
