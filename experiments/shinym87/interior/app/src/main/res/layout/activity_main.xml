<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 저장해 둔 "빈 배경" 대표 이미지를 카메라 위에 반투명으로 겹친다.
         clickable=false 라 터치는 아래 sceneView 로 그대로 전달된다. -->
    <ImageView
        android:id="@+id/backgroundOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.5"
        android:visibility="gone"
        android:contentDescription="배경 오버레이"
        android:clickable="false"
        android:focusable="false" />

    <!-- 서버가 돌려준 "삭제 후" 결과 이미지 (벽 평면 앵커를 못 잡았을 때의 전체화면 대체 표시).
         평소에는 3D quad 로 벽에 붙이고, 이 뷰는 fallback 이다. -->
    <ImageView
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="삭제 결과"
        android:clickable="false"
        android:focusable="false" />

    <!-- "TV 선택 모드"에서 화면을 드래그해 제거할 사물의 사각형(bounding box)을 그린다.
         visibility=gone 이면 터치를 먹지 않아 평소 탭/드래그에 영향이 없다. -->
    <com.hackathon.interior.remove.BboxSelectionView
        android:id="@+id/bboxSelectionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/arTopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWorkspaceHome"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:backgroundTint="#D91D1B19"
                android:text="⌂"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnWorkspaceSettings"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:backgroundTint="#D91D1B19"
                android:text="⚙"
                android:textColor="@android:color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/instruction_scan"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="6" />

        <LinearLayout
            android:id="@+id/arPrimaryActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCaptureBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="배경 촬영" />

            <Button
                android:id="@+id/btnToggleBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="배경 표시" />

            <!-- PHASE 5: 서버 카탈로그에서 새 가구를 골라 배치 (삭제-후-재배치와 별개). -->
            <Button
                android:id="@+id/btnAddFurniture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="가구 추가" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/opacitySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="50"
            android:visibility="gone" />

        <!-- 사물 제거 흐름 (P1-2/P1-3/P1-8/P1-9) -->

        <!-- 지울 사물 종류. 서버 요청의 objectType 이 이 선택값을 따라간다. -->
        <LinearLayout
            android:id="@+id/removalTypeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지울 사물"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:shadowColor="@android:color/black"
                android:shadowRadius="6" />

            <Spinner
                android:id="@+id/objectTypeSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="96dp"
                android:background="#33FFFFFF"
                android:popupBackground="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/removalSelectionRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTvSelectMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영역 선택 모드" />

            <Button
                android:id="@+id/btnClearSelection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:text="선택 취소" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/removalRequestRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRequestRemove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="삭제 요청" />

            <Button
                android:id="@+id/btnToggleRemoval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:text="삭제 전/후" />
        </LinearLayout>

        <TextView
            android:id="@+id/removalStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="6"
            android:text="" />
    </LinearLayout>

    <!-- PHASE 4/5: 삭제한 사물을 이동하는 패널. 삭제 완료 시 나타나고, 마커가 바로 떠서
         손가락으로 끌어 옮긴다("여기로 옮기기" 버튼 없음). -->
    <LinearLayout
        android:id="@+id/movedObjectPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원위치" />

            <Button
                android:id="@+id/btnMovedClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="치우기" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedShrink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="－" />

            <Button
                android:id="@+id/btnMovedGrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="＋" />

            <Button
                android:id="@+id/btnMovedRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="회전 ⟳" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovedRestore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="서버 배치 복원" />

            <Button
                android:id="@+id/btnMovedUndo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="실행 취소" />
        </LinearLayout>
    </LinearLayout>

    <!-- 가구를 선택하면 나타나는 조작 패널 (핀치로도 크기 조절 가능) -->
    <LinearLayout
        android:id="@+id/selectionPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectedNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="선택됨" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShrink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="－" />

            <Button
                android:id="@+id/btnGrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="＋" />

            <Button
                android:id="@+id/btnRotateLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="↶ 15°" />

            <Button
                android:id="@+id/btnRotateRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:text="15° ↷" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삭제" />

            <Button
                android:id="@+id/btnDeselect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="선택 해제" />
        </LinearLayout>
    </LinearLayout>

    <!-- 첫 화면 가구 브로셔. 항목을 선택하고 "우리 집에 적용"을 누른 뒤
         해당 종류에 맞는 평면(벽/바닥)을 탭하면 저폴리 3D 가구가 배치된다. -->
    <LinearLayout
        android:id="@+id/catalogPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E6000000"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="우리 집을 위한 가구 브로셔"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="샘플 가구를 선택해 실제 크기의 3D 모델로 배치해 보세요"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCatalogClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="닫기" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/catalogList"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/catalogSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="가구를 선택해 크기와 배치 위치를 확인하세요"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCatalogApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:enabled="false"
            android:text="우리 집에 적용" />
    </LinearLayout>

    <!-- 제공 Asset 디자인을 적용한 제품 진입 화면. AR 기능은 선택 후에만 노출한다. -->
    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3EEE7"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="720dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="42dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.22"
                        android:text="MY HOME"
                        android:textColor="#211E1B"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:letterSpacing="0.32"
                        android:text="INTERIOR"
                        android:textColor="#8B7256"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnHomeSettings"
                    android:layout_width="54dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#211E1B"
                    android:contentDescription="설정"
                    android:text="⚙"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginTop="22dp">

                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="따뜻한 거실 인테리어" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="CREATE YOUR SPACE"
                        android:textColor="#E5BD7D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="새로운 공간,\n새로운 일상"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="카메라로 공간을 읽고 가구를 직접 배치해 보세요."
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="어떤 작업을 시작할까요?"
                android:textColor="#211E1B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="기능별 화면은 필요할 때만 열립니다."
                android:textColor="#7C746C"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnHomeArPlacement"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#211E1B"
                android:text="▣   내 집에 AR로 배치하기   ›"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHomeSpaceEdit"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#DAB476"
                android:text="✦   사진에서 사물 지우기   ›"
                android:textAllCaps="false"
                android:textColor="#211E1B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHomeCatalog"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="▤   가구 카탈로그 둘러보기   ›"
                android:textAllCaps="false"
                android:textColor="#211E1B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.1"
                android:text="CURATED FOR YOU"
                android:textColor="#8B7256"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeCategoryLiving"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:contentDescription="거실 가구" />

                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeCategoryDining"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:contentDescription="주방 식탁" />

                <com.hackathon.interior.ui.AtlasCropView
                    android:id="@+id/homeCategoryDecor"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:contentDescription="데코 소품" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 서버 주소 등 기술 설정은 작업 화면에서 분리한다. -->
    <FrameLayout
        android:id="@+id/settingsScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3EEE7"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFFFF"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SETTINGS"
                android:textColor="#A17B45"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="앱 설정"
                android:textColor="#211E1B"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Interior API 서버 주소"
                android:textColor="#403A34"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#A17B45"
                android:hint="http://192.168.0.10:8000"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#211E1B"
                android:textColorHint="#887E75" />

            <TextView
                android:id="@+id/settingsServerHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="휴대폰과 서버 PC가 같은 Wi-Fi에 있어야 합니다."
                android:textColor="#7C746C"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSettingsSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#DAB476"
                android:text="저장"
                android:textColor="#211E1B"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSettingsCancel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#211E1B"
                android:text="닫기"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
