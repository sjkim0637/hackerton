<?xml version="1.0" encoding="utf-8"?>
<!--
  화보 사진이 화면 전체를 차지한다. 사진 위에는 가구를 가리키는 점 아이콘만 올라간다.
  제목과 설명은 사진 안에 이미 들어 있으므로 앱이 따로 글을 얹지 않는다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/catalogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0D0C">

    <FrameLayout
        android:id="@+id/magazinePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.hackathon.interior.ui.AtlasCropView
            android:id="@+id/magazineImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="인테리어 화보" />

        <FrameLayout
            android:id="@+id/hotspotLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnCatalogSettings"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_catalog_icon"
        android:contentDescription="설정"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        app:tint="#F2ECE4" />

    <FrameLayout
        android:id="@+id/catalogSettingsScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3EEE7"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFFFF"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결 설정"
                android:textColor="#211E1B"
                android:textSize="25sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Interior API 서버 주소"
                android:textColor="#403A34"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/catalogServerUrlInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:hint="http://192.168.0.10:8000"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true" />
            <Button
                android:id="@+id/btnCatalogSettingsSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#DAB476"
                android:text="저장"
                android:textColor="#211E1B" />
            <Button
                android:id="@+id/btnCatalogSettingsClose"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#211E1B"
                android:text="닫기"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
