<?xml version="1.0" encoding="utf-8"?>
<!--
  인테리어 잡지 한 페이지를 그대로 옮긴 구조이다.
  제호(masthead) - 발행 정보 - 큰 제목 - 사진 판(plate) - 사진 설명 - 쪽 번호 순서로 읽힌다.
  사진 판의 높이는 사진 비율에 맞춰 코드에서 정한다. 그래서 사진이 잘리거나 빈 여백이 생기지 않는다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/catalogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE5DA">

    <LinearLayout
        android:id="@+id/magazinePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="40dp"
        android:paddingEnd="26dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:text="MY HOME"
                    android:textColor="#1E1B18"
                    android:textSize="21sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.3"
                    android:text="INTERIOR MAGAZINE"
                    android:textColor="#9B7547"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCatalogSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="설정"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                app:tint="#4A423B" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#D3C3A6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/issueText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.14"
                android:textColor="#9B7547"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="SEPTEMBER · LIVING" />
            <TextView
                android:id="@+id/pageIndicatorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:textColor="#A79B8C"
                android:textSize="10sp"
                tools:text="01 / 03" />
        </LinearLayout>

        <TextView
            android:id="@+id/pageTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#1E1B18"
            android:textSize="27sp"
            tools:text="빛이 머무는 독서 공간" />

        <FrameLayout
            android:id="@+id/photoPlate"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="20dp">

            <com.hackathon.interior.ui.AtlasCropView
                android:id="@+id/magazineImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="인테리어 화보" />

            <FrameLayout
                android:id="@+id/hotspotLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/pageDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#6E665F"
            android:textSize="13sp"
            tools:text="사진 속 은은한 점을 눌러 이 가구를 내 공간에서 확인해 보세요." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="이 화보의 가구"
                android:textColor="#9B7547"
                android:textSize="10sp"
                android:textStyle="bold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#DCD1BF" />
            <LinearLayout
                android:id="@+id/creditsRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="52dp"
            android:layout_height="1dp"
            android:background="#D3C3A6" />

        <TextView
            android:id="@+id/pageHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.05"
            android:text="↑ ↓ 쓸어넘겨 다음 공간 보기"
            android:textColor="#A79B8C"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/catalogSettingsScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3EEE7"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFFFF"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결 설정"
                android:textColor="#211E1B"
                android:textSize="25sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Interior API 서버 주소"
                android:textColor="#403A34"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/catalogServerUrlInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:hint="http://192.168.0.10:8000"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true" />
            <Button
                android:id="@+id/btnCatalogSettingsSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#DAB476"
                android:text="저장"
                android:textColor="#211E1B" />
            <Button
                android:id="@+id/btnCatalogSettingsClose"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#211E1B"
                android:text="닫기"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
