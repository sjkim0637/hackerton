<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnGuideBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back_home" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/guide_title"
            android:textColor="#0B1736"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/guide_subtitle"
            android:textColor="#596277"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/guide_flow_description"
            android:scaleType="fitCenter"
            android:src="@drawable/guide_flow_hero" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/guide_step_scan"
            android:textColor="#0B1736"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/guide_step_scan"
            android:scaleType="centerCrop"
            android:src="@drawable/internal_scan_guide" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/guide_step_select"
            android:textColor="#0B1736"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/guide_step_select"
            android:scaleType="centerCrop"
            android:src="@drawable/internal_object_selection_guide" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/guide_step_place"
            android:textColor="#0B1736"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/guide_step_place"
            android:scaleType="centerCrop"
            android:src="@drawable/internal_placement_guide" />
    </LinearLayout>
</ScrollView>
