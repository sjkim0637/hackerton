# Interior AR 서버 설정. 환경변수 접두사는 INTERIOR_ 이다.
# 사용법: 이 파일을 .env 로 복사한 뒤 필요한 값만 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있으니 실제 키를 커밋할 걱정은 없다.

# ─────────────────────────────────────────────────────────────
# 외부 AI 프로바이더 선택: mock | external
#  - mock     : 실제 API 없이 동작. 대상 영역을 주변 색으로 덮어 "삭제"를 흉내낸다.
#  - external : Google Gemini 이미지 편집 API 를 호출해 실제로 사물을 지우고 배경을 복원한다.
INTERIOR_AI_PROVIDER=mock

# ─────────────────────────────────────────────────────────────
# external 일 때만 필요. Gemini API 키.
#  발급: https://aistudio.google.com/app/apikey  (Google AI Studio)
#  형식 예: AIzaSy........................................  (실제 값 아님)
INTERIOR_AI_API_KEY=

# 사용할 이미지 편집 모델. 비우면 코드 기본값(gemini-3.1-flash-image)을 쓴다.
# 계정에서 그 모델을 못 쓰면 사용 가능한 최신 이미지 모델로 바꾼다
#   예: gemini-2.5-flash-image
INTERIOR_AI_MODEL=gemini-3.1-flash-image

# Gemini REST 엔드포인트 베이스. 보통 그대로 둔다.
INTERIOR_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 외부 AI 호출 타임아웃(초). 이미지 생성은 느릴 수 있어 넉넉히 잡는다.
INTERIOR_AI_TIMEOUT_SECONDS=120

# ─────────────────────────────────────────────────────────────
# 작업(scene) 하나당 허용하는 외부 AI 최대 호출 횟수
INTERIOR_MAX_AI_CALLS_PER_SCENE=20
