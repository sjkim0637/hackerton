# 서버 설정. 환경변수 접두사는 INTERIOR_ 이다.
# 사용법: 이 파일을 .env 로 복사한 뒤 필요한 값만 채운다.
#   cp .env.example .env

# 외부 AI 프로바이더 선택: mock | external
#  - mock     : 실제 API 없이 동작. 대상 영역을 주변 색으로 덮어 "삭제" 흉내.
#  - external : 실제 외부 AI 이미지 편집 API 호출 (아직 미구현, 자리만 있음).
INTERIOR_AI_PROVIDER=mock

# INTERIOR_AI_PROVIDER=external 로 바꿀 때만 아래 3개를 채운다.
# 지금은 비워둬도 되고, 비어 있으면 external 선택 시 명확한 오류를 돌려준다.
INTERIOR_AI_API_KEY=
INTERIOR_AI_BASE_URL=
INTERIOR_AI_MODEL=

# 작업(scene) 하나당 허용하는 외부 AI 최대 호출 횟수
INTERIOR_MAX_AI_CALLS_PER_SCENE=20
