POSTGRES_DB=geotime
POSTGRES_USER=geotime
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://geotime:change-me@db:5432/geotime
POSTGIS_SCHEMA=public

# Supabase/Vercel production settings. Keep real values in ignored local files
# and in the Vercel Environment Variables dashboard only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=geo-time-assets
SUPABASE_STORAGE_PUBLIC=false
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.project-ref:change-me@pooler.example.com:5432/postgres

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=geotime
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=geo-time-assets

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:8000
LOG_LEVEL=INFO
AUTH_MODE=disabled
