{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Depth: Verify All",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Depth: Core Unit Test",
        "Depth: Android Lint",
        "Depth: Build Release AARs",
        "Depth: Build Debug APK"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Depth: Core Unit Test",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement\\gradlew.bat",
      "args": [
        ":depth-placement-core:test",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Depth: Android Lint",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement\\gradlew.bat",
      "args": [
        ":test-app:lintDebug",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Depth: Build Release AARs",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement\\gradlew.bat",
      "args": [
        ":depth-placement-arcore:assembleRelease",
        ":depth-placement-debug:assembleRelease",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Depth: Build Debug APK",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement\\gradlew.bat",
      "args": [
        ":test-app:assembleDebug",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Depth: Install Debug APK",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement\\gradlew.bat",
      "args": [
        ":test-app:installDebug",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "dependsOn": "Depth: Build Debug APK",
      "problemMatcher": []
    },
    {
      "label": "Depth: Run Test App",
      "type": "process",
      "command": "${env:ANDROID_HOME}\\platform-tools\\adb.exe",
      "args": [
        "shell",
        "am",
        "start",
        "-n",
        "com.project.depthplacement.lab/.MainActivity"
      ],
      "dependsOn": "Depth: Install Debug APK",
      "problemMatcher": []
    },
    {
      "label": "Depth: Clean",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement\\gradlew.bat",
      "args": [
        "clean",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\goguma-salad\\interior-depth-placement",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "problemMatcher": []
    }
  ]
}
