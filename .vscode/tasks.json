{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Interior Demo v1: Build Debug APK",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\shinym87\\interior\\gradlew.bat",
      "args": [
        ":app:assembleDebug",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\shinym87\\interior",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Interior Demo v1: Install Debug APK",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\shinym87\\interior\\gradlew.bat",
      "args": [
        ":app:installDebug",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\shinym87\\interior",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "dependsOn": "Interior Demo v1: Build Debug APK",
      "problemMatcher": []
    },
    {
      "label": "Interior Demo v1: Run on Device",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools\\adb.exe",
      "args": [
        "shell",
        "am",
        "start",
        "-n",
        "com.hackathon.interior/.CatalogActivity"
      ],
      "dependsOn": "Interior Demo v1: Install Debug APK",
      "problemMatcher": []
    },
    {
      "label": "Interior Demo v1: Clean",
      "type": "process",
      "command": "${workspaceFolder}\\experiments\\shinym87\\interior\\gradlew.bat",
      "args": [
        "clean",
        "--console=plain",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\experiments\\shinym87\\interior",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.12"
        }
      },
      "problemMatcher": []
    }
  ]
}
